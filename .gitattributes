# FASTQ reads (anywhere in the repo)
*.fastq filter=lfs diff=lfs merge=lfs -text
*.fq     filter=lfs diff=lfs merge=lfs -text

# Everything inside the hidden cache directory (the download cache)
.hyphae_cache/** filter=lfs diff=lfs merge=lfs -text
# Pfam HMM database files (they are ~150 MiB each)
Pfam-A.hmm* filter=lfs diff=lfs merge=lfs -text
# Assembly‑related intermediate files (binary blobs)
megahit_output/** filter=lfs diff=lfs merge=lfs -text
spades_output/**  filter=lfs diff=lfs merge=lfs -text
# Large final reports (often contain CSV/TSV/FASTA that exceed 100 MiB)
report_final/** filter=lfs diff=lfs merge=lfs -text
*.fastq[[:space:]]*.fq[[:space:]].hyphae_cache/**[[:space:]]Pfam-A.hmm*[[:space:]]megahit_output/**[[:space:]]spades_output/**[[:space:]]report_final/** filter=lfs diff=lfs merge=lfs -text
